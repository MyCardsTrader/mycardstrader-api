#!/bin/sh
set -e

current_branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$current_branch" = "main" ]; then
  echo "Direct commits on main are blocked."
  exit 1
fi

staged_files="$(mktemp)"
staged_ts_files="$(mktemp)"

cleanup() {
  rm -f "$staged_files" "$staged_ts_files"
}

trap cleanup EXIT

git diff --cached --name-only -z --diff-filter=ACMR > "$staged_files"

if [ -s "$staged_files" ]; then
  xargs -0 npx prettier --write --ignore-unknown < "$staged_files"
fi

git diff --cached --name-only -z --diff-filter=ACMR -- '*.ts' '*.tsx' > "$staged_ts_files"

if [ -s "$staged_ts_files" ]; then
  xargs -0 npx eslint --fix < "$staged_ts_files"
fi

if [ -s "$staged_files" ]; then
  xargs -0 git add < "$staged_files"
fi
